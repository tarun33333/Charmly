<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <StartupObject>Charmly.Installer.Program</StartupObject>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <AssemblyName>CharmlySetup</AssemblyName>
    <RootNamespace>Charmly.Installer</RootNamespace>
    <Product>Charmly Setup</Product>
    <Company>Tarun</Company>
    <Authors>Tarun</Authors>
    <Copyright>Copyright © 2026 Tarun</Copyright>
    <Version>0.9.2</Version>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\icon.ico" />
    <EmbeddedResource Include="../../publish/Charmly-v0.9.2-Windows-x64.zip" LogicalName="Payload.zip" Condition="Exists('../../publish/Charmly-v0.9.2-Windows-x64.zip')" />
  </ItemGroup>

</Project>
