<Window x:Class="Charmly.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Charmly Setup"
        Height="480" Width="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource WindowBg}"
        Icon="../Hangly.App/Assets/hangly.ico">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="1" />
            <RowDefinition Height="*" />
            <RowDefinition Height="1" />
            <RowDefinition Height="60" />
        </Grid.RowDefinitions>

        <!-- Top Header Bar -->
        <Border Grid.Row="0" Background="{StaticResource HeaderBg}" Padding="20,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                    <TextBlock x:Name="HeaderTitle" Text="Welcome to Charmly Setup" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock x:Name="HeaderSubtitle" Text="Interactive Desktop Charms for Windows" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0" />
                </StackPanel>
                <Image Grid.Column="1" Source="../Hangly.App/Assets/hangly.ico" Width="36" Height="36" RenderOptions.BitmapScalingMode="HighQuality" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="{StaticResource CardBorder}" />

        <!-- Main Wizard Pages Container -->
        <Grid Grid.Row="2" Margin="24,18">

            <!-- PAGE 0: Welcome -->
            <Grid x:Name="PageWelcome" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="Welcome to the Charmly Setup Wizard" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                    <TextBlock Text="Handcrafted interactive desktop charms by Tarun." FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0" />
                </StackPanel>

                <Border Grid.Row="1" Margin="0,14,0,10" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel>
                        <TextBlock Text="✨ What this will install on your computer:" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,10" />
                        <TextBlock Text="• 🧿 161 Interactive desktop charms across 21 collections" FontSize="12.5" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6" />
                        <TextBlock Text="• 🍋🌶️ Indian protective Nimbu-Mirchi with 2-day drying lifecycle and refresh" FontSize="12.5" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6" />
                        <TextBlock Text="• 🧵 6 Physics cord styles (Obsidian, Gold Chain, Silver Links, Crimson Ribbon)" FontSize="12.5" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6" />
                        <TextBlock Text="• ⚡ Verlet particle physics engine with zero idle CPU" FontSize="12.5" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6" />
                        <TextBlock Text="• 🛡️ 100% Standalone &amp; Self-contained — no prerequisites required" FontSize="12.5" Foreground="{StaticResource TextSecondary}" />
                    </StackPanel>
                </Border>

                <TextBlock Grid.Row="2" Text="Click Next to continue, or Cancel to exit Setup." FontSize="12" Foreground="{StaticResource TextMuted}" />
            </Grid>

            <!-- PAGE 1: License Agreement & Legal Disclaimer -->
            <Grid x:Name="PageDisclaimer" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="License Agreement &amp; Legal Disclaimer" FontSize="16" FontWeight="Bold" />
                    <TextBlock Text="Please review the agreement and disclaimer before continuing." FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0" />
                </StackPanel>

                <Border Grid.Row="1" Margin="0,10,0,10" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="12">
                    <TextBox x:Name="DisclaimerTextBox" Background="Transparent" Foreground="{StaticResource TextSecondary}"
                             BorderThickness="0" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             IsReadOnly="True" FontSize="11.5" FontFamily="Consolas, Segoe UI" />
                </Border>

                <CheckBox Grid.Row="2" x:Name="AgreeCheckBox" Content="I accept the agreement and legal disclaimer"
                          Checked="OnAgreeChanged" Unchecked="OnAgreeChanged" Margin="2,2,0,0" />
            </Grid>

            <!-- PAGE 2: Destination & Options -->
            <Grid x:Name="PageOptions" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="Select Installation Folder &amp; Startup Options" FontSize="16" FontWeight="Bold" />
                    <TextBlock Text="Where should Charmly be installed?" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,14,0,0">
                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="Destination Folder:" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="8,6">
                                <TextBox x:Name="InstallPathBox" Background="Transparent" Foreground="{StaticResource TextPrimary}" BorderThickness="0" FontSize="12.5" />
                            </Border>
                            <Button Grid.Column="1" Content="Browse..." Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" Click="OnBrowseFolderClicked" />
                        </Grid>
                    </StackPanel>

                    <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="14">
                        <StackPanel>
                            <TextBlock Text="Additional Setup Tasks:" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,10" />
                            <CheckBox x:Name="StartupCheckBox" IsChecked="True" Margin="0,0,0,8"
                                      Content="🚀 Start Charmly automatically when Windows starts (Recommended)" />
                            <CheckBox x:Name="DesktopShortcutCheckBox" IsChecked="True" Margin="0,0,0,8"
                                      Content="🖥️ Create a Desktop shortcut" />
                            <CheckBox x:Name="StartMenuCheckBox" IsChecked="True"
                                      Content="📂 Create a Start Menu shortcut" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- PAGE 3: Installing -->
            <Grid x:Name="PageInstalling" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" Margin="20,0">
                    <TextBlock Text="Installing Charmly..." FontSize="18" FontWeight="Bold" Margin="0,0,0,8" />
                    <TextBlock x:Name="InstallingStatus" Text="Extracting files..." FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,10" />
                    <ProgressBar x:Name="InstallProgress" Height="8" Minimum="0" Maximum="100" Value="0"
                                 Background="{StaticResource CardBg}" Foreground="{StaticResource AccentBlue}" BorderThickness="0" Margin="0,0,0,8" />
                    <TextBlock Text="Please wait while Setup installs Charmly on your computer." FontSize="12" Foreground="{StaticResource TextMuted}" />
                </StackPanel>
            </Grid>

            <!-- PAGE 4: Finished -->
            <Grid x:Name="PageFinished" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="Charmly Setup Complete! 🎉" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                    <TextBlock Text="Charmly has been successfully installed on your computer." FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0" />
                </StackPanel>

                <Border Grid.Row="1" Margin="0,16,0,10" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel>
                        <TextBlock Text="✨ Charmly is ready!" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" />
                        <TextBlock Text="Look for the charms hanging near the top edge of your screen. You can drag and swing them anytime, or open Customize from the system tray near your clock."
                                   TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource TextSecondary}" LineHeight="18" />
                        <TextBlock Text="Created with ❤️ by Tarun (https://itstarun.me)" Margin="0,10,0,0" FontSize="12" Foreground="{StaticResource TextMuted}" />
                    </StackPanel>
                </Border>

                <CheckBox Grid.Row="2" x:Name="LaunchCheckBox" IsChecked="True" Content="🚀 Launch Charmly now" Margin="2,0,0,0" FontWeight="SemiBold" />
            </Grid>
        </Grid>

        <Border Grid.Row="3" Background="{StaticResource CardBorder}" />

        <!-- Bottom Action Buttons Bar -->
        <Border Grid.Row="4" Background="{StaticResource HeaderBg}" Padding="20,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="CancelButton" Grid.Column="0" Content="Cancel" Style="{StaticResource SecondaryButton}" Click="OnCancelClicked" />

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="BackButton" Content="&lt; Back" Style="{StaticResource SecondaryButton}" Click="OnBackClicked" IsEnabled="False" Margin="0,0,8,0" />
                    <Button x:Name="NextButton" Content="Next &gt;" Style="{StaticResource PrimaryButton}" Click="OnNextClicked" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
